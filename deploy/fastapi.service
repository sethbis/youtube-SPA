[Unit]
Description=FastAPI Video Platform Service
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/Parcial-1/backend
ExecStart=/home/ubuntu/Parcial-1/backend/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
EnvironmentFile=/home/ubuntu/Parcial-1/backend/.env

[Install]
WantedBy=multi-user.target
